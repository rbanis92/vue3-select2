{
  "name": "vue3-select2",
  "version": "0.3.0",
  "description": "Select2 component for Vue 3 with v-model, multiple select, AJAX live search and custom id/text fields.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rbanis92/vue3-select2.git"
  },
  "keywords": [
    "vue",
    "vue3",
    "select2",
    "select",
    "dropdown",
    "autocomplete",
    "ajax"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "author": "rbanis92 <rbanis92@gmail.com> (https://github.com/rbanis92)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/rbanis92/vue3-select2/issues"
  },
  "homepage": "https://github.com/rbanis92/vue3-select2#readme",
  "main": "src/Select2.vue",
  "browser": {
    "./sfc": "src/Select2.vue"
  },
  "files": [
    "dist/*",
    "src/**/*.vue",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build:publish": "vue-cli-service build --target lib --name Select2 src/Select2.vue",
    "serve": "vue-cli-service serve",
    "build": "vue-cli-service build",
    "lint": "vue-cli-service lint"
  },
  "dependencies": {
    "jquery": "^3.7.1",
    "select2": "^4.0.13"
  },
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "devDependencies": {
    "@vue/cli-plugin-babel": "~4.5.0",
    "@vue/cli-plugin-eslint": "~4.5.0",
    "@vue/cli-service": "~4.5.0",
    "@vue/compiler-sfc": "^3.0.0",
    "babel-eslint": "^10.1.0",
    "eslint": "^6.7.2",
    "eslint-plugin-vue": "^7.0.0-0",
    "vue": "^3.0.0"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/vue3-essential",
      "eslint:recommended"
    ],
    "parserOptions": {
      "parser": "babel-eslint"
    },
    "rules": {}
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ]
}
